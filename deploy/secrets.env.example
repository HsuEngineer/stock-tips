# Copy to secrets.env (do NOT commit) and fill in values.
# Used by: deploy/install.sh and deploy/gcp-create-vm.sh
#
#   cp deploy/secrets.env.example deploy/secrets.env
#   nano deploy/secrets.env

# Required
DISCORD_TOKEN=your_bot_token
DISCORD_CHANNEL_ID=1234567890
DISCORD_OWNER_IDS=1234567890

# Optional overrides
# APP_LANGUAGE=zh-TW
# POLL_INTERVAL_MINUTES=10
# SHARP_MOVE_PCT=2.0
# GIT_REPO=https://github.com/HsuEngineer/stock-tips.git
# GIT_BRANCH=master
# INSTALL_DIR=/opt/stock-tips
# SERVICE_USER=ubuntu
# DB_NAME=Stock
# DB_USER=stocktips
# DB_PASSWORD=   # leave empty to auto-generate
